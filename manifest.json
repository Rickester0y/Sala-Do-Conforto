{
  "manifest_version": 3,
  "name": "Sala Confortável",
  "version": "1.0.0",
  "description": "Personalize o visual da Sala do Futuro para deixar o ambiente de estudo mais confortável.",

  "permissions": ["storage"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://saladofuturo.educacao.sp.gov.br/*"],
      "js": ["themes.js", "content.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["https://saladofuturo.educacao.sp.gov.br/*"]
    }
  ]
}
